library(tidyverse)
library(modelr)


# Create a tibble with cylinders as a categorical variable
car_data <- mtcars %>%
  as_tibble() %>%
  transmute(
    cyl = factor(cyl),
    wt = wt
  )


# Fit a linear model predicting weight from cylinder category
car_model <- lm(wt ~ cyl, data = car_data)


# Create a grid of cylinder categories and add predictions
car_predictions <- car_data %>%
  data_grid(cyl) %>%
  add_predictions(car_model)


# Plot the original data and predicted values
ggplot(car_data, aes(x = cyl, y = wt)) +
  geom_jitter(
    width = 0.12,
    size = 3,
    alpha = 0.70,
    color = "hotpink"
  ) +
  geom_point(
    data = car_predictions,
    aes(y = pred),
    color = "red",
    size = 4
  ) +
  labs(
    title = "Car Weight by Cylinder Category",
    subtitle = "Pink points show cars and red points show predictions",
    x = "Number of Cylinders",
    y = "Weight in 1,000 Pounds"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(
      color = "deeppink4",
      face = "bold",
      size = 16
    ),
    plot.subtitle = element_text(
      color = "purple4",
      size = 11
    ),
    axis.title = element_text(
      color = "deeppink4",
      face = "bold"
    ),
    panel.grid.minor = element_blank()
  )


# Analysis:
# The model predicts a different average vehicle weight for each cylinder
# category. Cars with four cylinders have the lowest predicted weight, while
# cars with eight cylinders have the highest predicted weight. This indicates
# that vehicles with more cylinders generally tend to weigh more. The spread
# of the original points also shows variation within each cylinder category.